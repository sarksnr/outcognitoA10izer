{
	"manifest_version": 3,
	"name": "A10izer",
	"version": "1.1",
	"description": "You need A10 everywhere dont you..?",
	"permissions": ["activeTab", "storage"],
	"action": {
    "default_popup": "popup.html"
	},
	"browser_specific_settings": {
    	"gecko": {
      	"id": "A10izer-addon@nambiar.cet.dev.local",
		"data_collection_permissions": {
        "required": ["none"]
      }
    	}
  	},
	"content_scripts": [
	{
		"matches": ["<all_urls>"],
		"js":["content.js"]
		}
		]
}
